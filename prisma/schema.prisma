datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Platform {
  id             Int             @id @default(autoincrement())
  name           String          @unique
  playerAccounts PlayerAccount[]
  games          Game[]

  @@map("platforms")
}

model User {
  id             Int             @id @default(autoincrement())
  email          String          @unique
  passwordHash   String          @map("password_hash")
  createdAt      DateTime        @default(now()) @map("created_at")
  playerAccounts PlayerAccount[]
  trainingPlans  TrainingPlan[]

  @@map("users")
}

model PlayerAccount {
  id           Int           @id @default(autoincrement())
  userId       Int           @map("user_id")
  platformId   Int           @map("platform_id")
  username     String
  lastSyncedAt DateTime?     @map("last_synced_at")
  createdAt    DateTime      @default(now()) @map("created_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform     Platform      @relation(fields: [platformId], references: [id])
  games        Game[]
  analysisJobs AnalysisJob[]

  @@unique([platformId, username])
  @@map("player_accounts")
}

model Result {
  id    Int    @id @default(autoincrement())
  code  String @unique
  games Game[]

  @@map("results")
}

model TimeControl {
  id               Int    @id @default(autoincrement())
  baseSeconds      Int    @map("base_seconds")
  incrementSeconds Int    @map("increment_seconds")
  category         String
  games            Game[]

  @@unique([baseSeconds, incrementSeconds])
  @@map("time_controls")
}

model Opening {
  id    Int    @id @default(autoincrement())
  eco   String
  name  String
  games Game[]

  @@unique([eco, name])
  @@map("openings")
}

model Game {
  id             Int       @id @default(autoincrement())
  playerAccountId Int      @map("player_account_id")
  platformId     Int       @map("platform_id")
  externalId     String    @map("external_id")
  playedAt       DateTime  @map("played_at")
  color          String
  resultId       Int       @map("result_id")
  openingId      Int?      @map("opening_id")
  timeControlId  Int?      @map("time_control_id")
  playerRating   Int?      @map("player_rating")
  opponentRating Int?      @map("opponent_rating")
  totalPlies     Int       @map("total_plies")
  analysisStatus String    @default("pending") @map("analysis_status")
  failureReason  String?   @map("failure_reason")

  playerAccount PlayerAccount @relation(fields: [playerAccountId], references: [id], onDelete: Cascade)
  platform      Platform      @relation(fields: [platformId], references: [id])
  result        Result        @relation(fields: [resultId], references: [id])
  opening       Opening?      @relation(fields: [openingId], references: [id])
  timeControl   TimeControl?  @relation(fields: [timeControlId], references: [id])
  moves         Move[]
  analysisJobGames AnalysisJobGame[]

  @@unique([platformId, externalId])
  @@index([playerAccountId, playedAt])
  @@map("games")
}

model Phase {
  id    Int    @id @default(autoincrement())
  name  String @unique
  moves Move[]

  @@map("phases")
}

model Move {
  id               Int                 @id @default(autoincrement())
  gameId           Int                 @map("game_id")
  ply              Int
  san              String
  uci              String
  fenBefore        String              @map("fen_before")
  moverColor       String              @map("mover_color")
  clockRemainingMs Int?                @map("clock_remaining_ms")
  timeSpentMs      Int?                @map("time_spent_ms")
  phaseId          Int                 @map("phase_id")

  game           Game                @relation(fields: [gameId], references: [id], onDelete: Cascade)
  phase          Phase               @relation(fields: [phaseId], references: [id])
  eval           MoveEval?
  mate           MoveMate?
  classification MoveClassification?
  motifs         MoveMotif[]

  @@unique([gameId, ply])
  @@map("moves")
}

// Engine version rows are immutable by design
model EngineVersion {
  id           Int        @id @default(autoincrement())
  name         String
  version      String
  defaultDepth Int        @map("default_depth")
  threads      Int?       @default(1)
  hashSize     Int?       @default(64) @map("hash_size")
  evals        MoveEval[]

  @@unique([name, version, defaultDepth, threads, hashSize])
  @@map("engine_versions")
}

model MoveEval {
  moveId          Int           @id @map("move_id")
  evalBeforeCp    Int           @map("eval_before_cp")
  evalAfterCp     Int           @map("eval_after_cp")
  bestUci         String        @map("best_uci")
  depth           Int
  engineVersionId Int           @map("engine_version_id")

  move          Move          @relation(fields: [moveId], references: [id], onDelete: Cascade)
  engineVersion EngineVersion @relation(fields: [engineVersionId], references: [id])

  @@map("move_evals")
}

// Separate table for mate evaluations so move_evals remains non-null and compact; forced mates are sparse
model MoveMate {
  moveId     Int   @id @map("move_id")
  mateBefore Int?  @map("mate_before")
  mateAfter  Int?  @map("mate_after")

  move Move @relation(fields: [moveId], references: [id], onDelete: Cascade)

  @@map("move_mates")
}

model Classification {
  id                  Int                  @id @default(autoincrement())
  name                String               @unique
  moveClassifications MoveClassification[]

  @@map("classifications")
}

model MoveClassification {
  moveId           Int            @id @map("move_id")
  classificationId Int            @map("classification_id")
  cpLoss           Int            @map("cp_loss")

  move           Move           @relation(fields: [moveId], references: [id], onDelete: Cascade)
  classification Classification @relation(fields: [classificationId], references: [id])

  @@map("move_classifications")
}

model Motif {
  id                Int                @id @default(autoincrement())
  name              String             @unique
  moveMotifs        MoveMotif[]
  puzzleMotifs      PuzzleMotif[]
  trainingPlanItems TrainingPlanItem[]

  @@map("motifs")
}

model MoveMotif {
  moveId  Int    @map("move_id")
  motifId Int    @map("motif_id")
  kind    String @default("allowed")

  move  Move  @relation(fields: [moveId], references: [id], onDelete: Cascade)
  motif Motif @relation(fields: [motifId], references: [id])

  @@id([moveId, motifId, kind])
  @@map("move_motifs")
}

model Puzzle {
  id                Int                @id @default(autoincrement())
  lichessId         String             @unique @map("lichess_id")
  fen               String
  movesUci          String             @map("moves_uci")
  rating            Int
  phaseTag          String?            @map("phase_tag")
  motifs            PuzzleMotif[]
  trainingPlanItems TrainingPlanItem[]

  @@map("puzzles")
}

model PuzzleMotif {
  puzzleId Int    @map("puzzle_id")
  motifId  Int    @map("motif_id")

  puzzle   Puzzle @relation(fields: [puzzleId], references: [id], onDelete: Cascade)
  motif    Motif  @relation(fields: [motifId], references: [id])

  @@id([puzzleId, motifId])
  @@map("puzzle_motifs")
}

model TrainingPlan {
  id        Int                @id @default(autoincrement())
  userId    Int                @map("user_id")
  createdAt DateTime           @default(now()) @map("created_at")

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     TrainingPlanItem[]

  @@map("training_plans")
}

model TrainingPlanItem {
  id          Int          @id @default(autoincrement())
  planId      Int          @map("plan_id")
  puzzleId    Int          @map("puzzle_id")
  motifId     Int?         @map("motif_id")
  reasonCode  String       @map("reason_code")
  completedAt DateTime?    @map("completed_at")

  plan        TrainingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  puzzle      Puzzle       @relation(fields: [puzzleId], references: [id])
  motif       Motif?       @relation(fields: [motifId], references: [id])

  @@map("training_plan_items")
}

// Partial unique index idx_analysis_jobs_active_unique enforces one active import job per account.
// All raw SQL timestamp columns must use (NOW() AT TIME ZONE 'UTC').
model AnalysisJob {
  id              Int               @id @default(autoincrement())
  playerAccountId Int               @map("player_account_id")
  status          String            @default("queued")
  attempts        Int               @default(0)
  maxGames        Int?              @default(50) @map("max_games")
  since           DateTime?
  until           DateTime?
  lockedBy        String?           @map("locked_by")
  lockedAt        DateTime?         @map("locked_at")
  heartbeatAt     DateTime?         @map("heartbeat_at")
  error           String?
  failedGames     Int?              @default(0) @map("failed_games")
  skippedGames    Int?              @default(0) @map("skipped_games")
  createdAt       DateTime          @default(now()) @map("created_at")
  finishedAt      DateTime?         @map("finished_at")

  playerAccount   PlayerAccount     @relation(fields: [playerAccountId], references: [id], onDelete: Cascade)
  jobGames        AnalysisJobGame[]

  @@index([status, createdAt])
  @@map("analysis_jobs")
}

model AnalysisJobGame {
  jobId  Int         @map("job_id")
  gameId Int         @map("game_id")
  status String      @default("pending")
  error  String?

  job    AnalysisJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  game   Game        @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@id([jobId, gameId])
  @@map("analysis_job_games")
}

