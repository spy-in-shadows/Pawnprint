DATABASE_URL=postgresql://chess:chess@localhost:5432/chess_analytics
PORT=3000
NODE_ENV=development
# At least 32 characters; the server refuses to start otherwise. Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-value-of-32-or-more-characters
# Access-token (JWT) lifetime, any jsonwebtoken duration such as 15m or 1h.
ACCESS_TOKEN_TTL=15m
# Refresh-token lifetime in days (rotating, httpOnly cookie).
REFRESH_TOKEN_TTL_DAYS=7
STOCKFISH_PATH=/opt/homebrew/bin/stockfish
ENGINE_DEPTH=12
ENGINE_THREADS=1
ENGINE_HASH_MB=64
PG_POOL_MAX=10
LOG_LEVEL=info
JOB_STALE_SECONDS=120

# Comma-separated origins allowed to call the API cross-origin (empty = same-origin only).
# Example for the Vite dev server: CORS_ORIGINS=http://localhost:5173
CORS_ORIGINS=
# Set to true to log every Prisma query (text, params, duration in ms) through the app logger.
# Off by default; params can contain emails and password hashes, so use it only for local debugging.
PRISMA_LOG_QUERIES=false
# Number of reverse proxies in front of the API (nginx, a load balancer, a PaaS router): 1 for one proxy.
# Default false: req.ip is the socket address. Behind a proxy that would be the proxy's own address,
# so every client would share one rate-limit bucket. Only set it when a proxy is really there, because
# a trusted X-Forwarded-For header can otherwise be forged by clients to dodge the rate limit.
TRUST_PROXY=false
